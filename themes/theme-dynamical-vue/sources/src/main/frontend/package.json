{
  "name": "@dynamia-tools/theme-dynamical-vue",
  "version": "26.11.0",
  "description": "Vue 3 + Tailwind CSS 4 application shell of the DynamicalVue theme: navigation-driven layout, login, skins, CRUD / config / embedded pages",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/createDynamiaApp.ts",
    "./src/mountLogin.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./vite": {
      "types": "./vite-preset.d.ts",
      "default": "./vite-preset.js"
    },
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "vite-preset.js",
    "vite-preset.d.ts",
    "!src/main.ts",
    "!src/login.ts",
    "!src/components/StarRatingHost.vue",
    "!src/lib/starRatingManager.ts",
    "!src/**/*.test.ts"
  ],
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-shell-views.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dynamia-tools/sdk": "workspace:*",
    "@dynamia-tools/tailadmin-vue": "^26.9.7",
    "@dynamia-tools/ui-core": "workspace:*",
    "@dynamia-tools/vue": "workspace:*",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "vue-tsc": "^2.2.12"
  }
}
