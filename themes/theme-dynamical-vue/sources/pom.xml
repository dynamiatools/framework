<project
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
        xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tools.dynamia.themes</groupId>
        <artifactId>tools.dynamia.themes.parent</artifactId>
        <version>26.9.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <name>Themes - Vue Dynamical</name>
    <artifactId>tools.dynamia.themes.dynamical-vue</artifactId>
    <url>https://www.dynamia.tools/themes/dynamical-vue</url>
    <description>Vue 3 + Tailwind CSS enterprise theme for DynamiaTools (sidebar/topbar/content/footer shell), native
        login and per-page &lt;dynamia-embed&gt; rendering
    </description>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Dynamia Soluciones IT SAS</name>
        <url>https://www.dynamiasoluciones.com</url>
    </organization>

    <developers>
        <developer>
            <name>Mario Serrano Leones</name>
            <email>mario@dynamiasoluciones.com</email>
            <organization>Dynamia Soluciones IT</organization>
            <organizationUrl>https://www.dynamiasoluciones.com</organizationUrl>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>APACHE LICENSE, VERSION 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/dynamiatools/theme-dynamical-vue</url>
    </scm>

    <properties>
        <frontend.dir>src/main/frontend</frontend.dir>
        <frontend-maven-plugin.version>2.0.1</frontend-maven-plugin.version>
        <node.version>v24.13.1</node.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${source.encoding}</encoding>
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <!--
              Builds the Vue + Tailwind frontend (src/main/frontend) as part of the Maven
              lifecycle, all-in-one: no separate pnpm bootstrap step required.

              - install-node-and-corepack: provisions a private Node 24 + corepack, local to
                this module (target/node), it does not touch any Node/pnpm already on the PATH.
              - corepack "pnpm install": installs frontend dependencies (pnpm version is read
                from src/main/frontend/package.json's "packageManager" field).
              - corepack "pnpm run build" filtered to this frontend's workspace deps: builds the workspace packages this frontend
                depends on (@dynamia-tools/sdk, ui-core, vue). They resolve to their gitignored `dist/`
                outputs, which don't exist on a clean checkout (CI) — without this step the vite build
                fails with "failed to resolve import @dynamia-tools/vue". pnpm builds them in
                dependency order.
              - corepack "pnpm run build": runs `vite build` for both the authenticated app
                shell (index.html) and the login page (login.html), then a small postbuild
                script copies the two HTML shells into target/classes/views/ (resolved by
                Spring's ClassPathViewResolver) and the hashed JS/CSS bundles into
                target/classes/web/templates/dynamicalvue/ (resolved by
                ApplicationTemplateResourceHandler) — see ApplicationTemplateResourceHandler /
                MvcConfiguration in tools.dynamia:tools.dynamia.app for the resolution contract.

              All four executions are bound to generate-resources, i.e. before
              process-resources copies src/main/resources into target/classes, so both sets of
              files end up on the final jar's classpath together.
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>${frontend.dir}</workingDirectory>
                    <nodeVersion>${node.version}</nodeVersion>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-corepack</id>
                        <goals>
                            <goal>install-node-and-corepack</goal>
                        </goals>
                        <phase>generate-resources</phase>
                    </execution>
                    <execution>
                        <id>pnpm-install</id>
                        <goals>
                            <goal>corepack</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>pnpm install --frozen-lockfile</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pnpm-build-workspace-deps</id>
                        <goals>
                            <goal>corepack</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>pnpm --filter theme-dynamical-vue-frontend^... run build</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>pnpm-build</id>
                        <goals>
                            <goal>corepack</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>pnpm run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Frontend build output lives directly under target/classes (see scripts/copy-shell-views.mjs),
                 skip clean's default target wipe interfering mid-reactor build; nothing extra needed here. -->
        </plugins>
    </build>

    <dependencies>
        <!-- ApplicationTemplate / ApplicationTemplateSkin / @InstallApplicationTemplate contract -->
        <dependency>
            <groupId>tools.dynamia</groupId>
            <artifactId>tools.dynamia.templates</artifactId>
            <version>26.7.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>
