    "@dynamia-tools/dashboard-vue": "file:../../../extensions/dashboard/packages/dashboard-vue",
    "@dynamia-tools/reports-sdk": "file:../../../extensions/reports/packages/reports-sdk",
    "@dynamia-tools/reports-vue": "file:../../../extensions/reports/packages/reports-vue",
    "@dynamia-tools/sdk": "file:../../../platform/packages/sdk",
    "@dynamia-tools/vue": "file:../../../platform/packages/vue",
    "chart.js": "^4.4.0",
    "vue": "^3.5.26",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.7.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.7.3",
